# Server-only configuration. Fill values in hosted Sites secrets, not browser code.
DASHBOARD_ACCESS_KEY=
# No login: base URL automatically creates an anonymous signed session.
DASHBOARD_LINK_ONLY=true
BAZE_API_KEY=
BAZE_MODEL=gpt-6.1-sol
SITE_OWNER_EMAIL=
# Official read-only Toss Open API; use a dedicated client for this dashboard.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_TOKEN_ENCRYPTION_KEY=
# Confirm data display/sharing authorization first. Local IP != hosted egress IP.
TOSS_SHARING_APPROVED=false
# Authorized TrendForce/license-holder HTTPS JSON feed; no unapproved crawling.
MEMORY_FEED_URL=
MEMORY_FEED_KEY=
MEMORY_REDISTRIBUTION_APPROVED=false
